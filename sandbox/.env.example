# ─── sandbox — Docker-socket-scoped sandboxed command execution ─────────────
# Runs agent-issued shell commands (tests, linters, builds, git, package
# installs) inside a throwaway, resource-capped container with exactly one
# registered project directory mounted. See docs/ai-setup-checklist.md
# "Sandboxed command execution".

# ─── Network ──────────────────────────────────────────────────────────────────
SANDBOX_PORT_HOST=8102

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Shared secret checked against the X-Sandbox-Token header. Generated by
# start.sh on first run; must match SANDBOX_TOKEN in mcp-tools/.env.
SANDBOX_TOKEN=GENERATE_ME

# ─── Workspaces root (required) ───────────────────────────────────────────────
# Absolute host path — MUST be the exact same value as mcp-tools/.env's
# WORKSPACES_ROOT. Not mounted into this container (see main.py); used only
# to compute the host-side bind-mount source for each ephemeral container.
# No ~ or $HOME expansion — use the literal absolute path. No safe default;
# the service fails to start without it.
WORKSPACES_ROOT=/home/YOUR_USER/workspace

# ─── Ephemeral container image ────────────────────────────────────────────────
# Built by start.sh from runtime.Dockerfile (git, curl, python3, node,
# build-essential). Override to swap in a different toolchain later.
SANDBOX_RUNTIME_IMAGE=makerops-sandbox-runtime:latest

# ─── Resource limits (per ephemeral container) ────────────────────────────────
SANDBOX_MEM_LIMIT=2g
SANDBOX_CPUS=2
SANDBOX_PIDS_LIMIT=256

# UID/GID the command runs as inside the container — match your host user
# so files it creates in the project directory aren't root-owned. Check
# with `id -u` / `id -g` on the host.
SANDBOX_RUN_UID=1000
SANDBOX_RUN_GID=1000

# Captured stdout/stderr are each truncated to this many characters before
# being returned to the caller.
SANDBOX_MAX_OUTPUT_CHARS=8000

# ─── Timezone ─────────────────────────────────────────────────────────────────
TZ=America/Chicago
