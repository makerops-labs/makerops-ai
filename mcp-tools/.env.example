# ─── MCP Tools — Shared LLM Tool Server ───────────────────────────────────────
# One MCP server holding all LLM tools: web search (SearXNG), URL fetching,
# and read/write access to the stack's services. Consumed by openwebui and
# smolagents. Domains whose token below is empty are skipped at startup —
# fill in tokens as you enable services.

# ─── Server ───────────────────────────────────────────────────────────────────
# Port the MCP server listens on (host side).
MCPTOOLS_PORT_HOST=8099

# Public URL used in messages shown to the user (approvals links).
MCPTOOLS_PUBLIC_URL=http://mcp.localhost

# ─── Write policy ─────────────────────────────────────────────────────────────
# Token protecting the /approvals web UI. Auto-generated by start.sh on first
# run. Open http://mcp.localhost/approvals?token=<value> once per browser.
APPROVALS_TOKEN=GENERATE_ME

# Optional: webhook POSTed on every notify/pending write event. Point it at an
# n8n webhook that emails or pushes the JSON payload to you.
APPROVAL_NOTIFY_WEBHOOK=

# Pending (gated) actions expire after this many hours if not approved.
APPROVAL_TTL_HOURS=24

# Trust tuning — comma lists of "domain" or "domain.tool_name" entries.
# GATE_EXEMPT downgrades gated writes to notify-only (deletions always gate);
# FORCE_GATE upgrades notify-tier writes to require approval.
# Example: APPROVAL_GATE_EXEMPT=comfyui,inventree.inventree_adjust_stock
# project ships notify-tier by default — see "Project workspaces" below:
# creating/registering a project directory is itself the authorization.
APPROVAL_GATE_EXEMPT=project
APPROVAL_FORCE_GATE=

# ─── Web / search ─────────────────────────────────────────────────────────────
# Local SearXNG instance (searxng).
SEARXNG_URL=http://host.docker.internal:8098

# ─── Outline (wiki) ───────────────────────────────────────────────────────────
# Token: Outline → Settings → API & Apps → New API key
OUTLINE_URL=http://host.docker.internal:3001
OUTLINE_API_TOKEN=

# ─── InvenTree (inventory) ────────────────────────────────────────────────────
# Token: InvenTree → user menu → Settings → Security → API Tokens → Add
INVENTREE_URL=http://host.docker.internal:8096
INVENTREE_API_TOKEN=

# ─── Plane (projects) ─────────────────────────────────────────────────────────
# Key: Plane → Profile Settings → API tokens → Add API token (user-scoped —
# works across every workspace the user belongs to, not just one).
# PLANE_WORKSPACE_SLUG is only a convenience default (first path segment of
# a workspace URL, e.g. http://localhost:8100/<slug>/). Leave it empty to
# make every tool call require an explicit workspace_slug — the agent calls
# plane_list_workspaces and asks the user which one when it's ambiguous.
# PLANE_WORKSPACE_SLUGS (comma-separated) backs plane_list_workspaces — kept
# by hand because Plane's public API has no workspace-discovery endpoint.
PLANE_URL=http://host.docker.internal:8100
PLANE_API_KEY=
PLANE_WORKSPACE_SLUG=
PLANE_WORKSPACE_SLUGS=

# ─── n8n (automation) ─────────────────────────────────────────────────────────
# Key: n8n → Settings → n8n API → Create an API key
N8N_URL=http://host.docker.internal:5678
N8N_API_KEY=

# ─── ComfyUI (image generation) ───────────────────────────────────────────────
# No token. COMFYUI_CHECKPOINT picks the model checkpoint; leave empty to use
# the first one ComfyUI reports.
COMFYUI_URL=http://host.docker.internal:8188
COMFYUI_PUBLIC_URL=http://comfyui.localhost
COMFYUI_CHECKPOINT=

# ─── FreeScout (help desk) ────────────────────────────────────────────────────
# Requires the paid "API & Webhooks" module. Key: Manage → API & Webhooks.
# FreeScout rejects requests whose Host header differs from its SITE_URL, so
# FREESCOUT_SITE_HOST must be the browser-facing host:port.
FREESCOUT_URL=http://host.docker.internal:8095
FREESCOUT_API_KEY=
FREESCOUT_SITE_HOST=localhost:8095

# ─── draw.io (diagrams) ───────────────────────────────────────────────────────
# No token; used to build the returned edit links.
DRAWIO_PUBLIC_URL=http://draw.localhost

# ─── Speech (TTS audio creation) ──────────────────────────────────────────────
# No token; the local Kokoro TTS service (speech). Generated audio is written
# under data/generated/audio/ and served at <MCPTOOLS_PUBLIC_URL>/files/audio/.
SPEECH_TTS_URL=http://host.docker.internal:8093
SPEECH_TTS_VOICE=af_heart

# ─── TRELLIS (image-to-3D generation) ─────────────────────────────────────────
# No token; the local TRELLIS job server (trellis, GPU, start-on-demand).
# Generated GLB models are written under data/generated/models/ and served at
# <MCPTOOLS_PUBLIC_URL>/files/models/.
TRELLIS_URL=http://host.docker.internal:8094

# ─── trigger.dev (background jobs) ────────────────────────────────────────────
# Project secret key (tr_...): trigger.dev project → API Keys
TRIGGERDEV_URL=http://host.docker.internal:3040
TRIGGERDEV_SECRET_KEY=

# ─── Self-improvement loop (propose_code_change / redeploy) ──────────────────
# Docker-socket-scoped restart proxy (redeploy/, separate service — mcp-tools
# itself never touches Docker). REDEPLOY_TOKEN must match redeploy/.env's
# value (generated by redeploy/start.sh on first run).
REDEPLOY_URL=http://host.docker.internal:8101
REDEPLOY_TOKEN=

# ─── Project workspaces (durable, user-assigned directories) ────────────────
# Absolute host path to your ~/workspace directory — project directories are
# its direct children (siblings of ~/workspace/makerops/, whose writes stay
# governed by propose_code_change/redeploy, not this feature). No ~ or $HOME
# expansion; use the literal absolute path. Required — mcp-tools will not
# start without this set.
WORKSPACES_ROOT=/home/YOUR_USER/workspace

# ─── Sandboxed command execution (project_run_command / sandbox) ────────────
# Separate service (sandbox/) with its own Docker-socket access, scoped to
# launching resource-capped, ephemeral, socket-less containers — one project
# directory mounted, nothing else. SANDBOX_TOKEN must match sandbox/.env's
# value (generated by sandbox/start.sh on first run).
SANDBOX_URL=http://host.docker.internal:8102
SANDBOX_TOKEN=
SANDBOX_MAX_TIMEOUT_S=600

# ─── Data path (optional) ─────────────────────────────────────────────────────
# Host path for approvals, audit log, provenance registry, saved diagrams.
MCPTOOLS_DATA_PATH=./data/mcp-tools

# ─── Timezone ─────────────────────────────────────────────────────────────────
TZ=America/Chicago
