# ─── redeploy — Docker-socket-scoped restart proxy ───────────────────────────
# Applies approved code changes and restarts the affected container. See
# docs/ai-setup-checklist.md "Self-improvement loop".

# ─── Network ──────────────────────────────────────────────────────────────────
REDEPLOY_PORT_HOST=8101

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Shared secret checked against the X-Redeploy-Token header. Generated by
# start.sh on first run; must match REDEPLOY_TOKEN in mcp-tools/.env.
REDEPLOY_TOKEN=GENERATE_ME

# ─── Notifications ────────────────────────────────────────────────────────────
# Same n8n webhook as mcp-tools/.env's APPROVAL_NOTIFY_WEBHOOK — redeploy
# fires its own "restarted successfully" / "reverted" notice independently,
# since it may be restarting the very service that would otherwise report it.
APPROVAL_NOTIFY_WEBHOOK=

# Public URL of mcp-tools, used in notification messages.
MCPTOOLS_PUBLIC_URL=http://mcp.localhost

# ─── Paths (optional) ──────────────────────────────────────────────────────────
# Host path of the makerops-ai repo root (read-write — a failed change must
# be revertible regardless of which file it touched).
MAKEROPS_AI_ROOT=..

# Host path of mcp-tools' data dir (shares its audit.jsonl).
MCPTOOLS_DATA_PATH=../mcp-tools/data/mcp-tools

# ─── Timezone ─────────────────────────────────────────────────────────────────
TZ=America/Chicago
