# ─── TRELLIS — Image-to-3D Generation ─────────────────────────────────────────
# microsoft/TRELLIS-image-large wrapped in a small FastAPI job server
# (serve.py). Consumed by mcp-tools' trellis domain / the studio agent.
# GPU-heavy and start-on-demand — see README.md.

# ─── Network ──────────────────────────────────────────────────────────────────
# Host port for the job server API.
TRELLIS_PORT_HOST=8094

# ─── Model ────────────────────────────────────────────────────────────────────
# Hugging Face model id. Weights (~4.5 GB) download on first start into
# TRELLIS_DATA_PATH/hf. Public repo — no token needed.
TRELLIS_MODEL_ID=microsoft/TRELLIS-image-large

# Seconds of idle time before the pipeline is unloaded from VRAM.
# 0 disables unloading (keeps ~5 GB resident while the container runs).
TRELLIS_IDLE_UNLOAD_S=600

# Optional Hugging Face token — only needed if you point TRELLIS_MODEL_ID
# at a gated repo.
#HF_TOKEN=

# ─── Data path (optional) ─────────────────────────────────────────────────────
# Host path for model caches (hf/, torch/, u2net/) and job outputs (jobs/).
TRELLIS_DATA_PATH=./data

# ─── Timezone ─────────────────────────────────────────────────────────────────
TZ=America/Chicago
