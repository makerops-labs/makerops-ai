# ─── smolagents — AI Agent Workspace ─────────────────────────────────────────
# Runs Hugging Face smolagents against the local Ollama server.
# Requires makerops-core/ai/ollama to be running with the models below pulled.
# Leads (see the model hierarchy table in README.md):
#   docker exec ollama ollama pull qwen3.6:35b       (~23 GB download)
#   docker exec ollama ollama pull qwen3.5:9b        (~6.6 GB), then create
#   the 64K-context variant per docs/ai-setup-checklist.md (qwen3.5:9b-64k)
# Reviewer pool (audit agent) / debate critic:
#   docker exec ollama ollama pull qwen3-coder:30b   (~19 GB)
#   docker exec ollama ollama pull gemma4:12b        (~7.6 GB)
#   docker exec ollama ollama pull gpt-oss:20b       (~13 GB)
# Debate entrepreneur/monitor use qwen3.6:35b-64k — same derivative as the
# default-chat lead (docs/ai-setup-checklist.md §1).

# ─── Network ──────────────────────────────────────────────────────────────────
# Host port for the Gradio agent UI.
SMOLAGENTS_PORT_HOST=8090

# ─── Ollama backend ───────────────────────────────────────────────────────────
# OpenAI-compatible endpoint of Ollama.
#   From inside the container (default): http://host.docker.internal:11434/v1
#   From a host venv (uv run):           http://localhost:11434/v1
OLLAMA_API_BASE=http://host.docker.internal:11434/v1

# API key sent to Ollama. Ollama ignores it, but the client requires a value.
OLLAMA_API_KEY=ollama

# ─── Models ───────────────────────────────────────────────────────────────────
# Lead model for the coding agent. Must be pulled in Ollama first.
SMOLAGENTS_CODING_MODEL_ID=qwen3.6:35b

# Lead model for planning, chat, and web research (manager + web_researcher).
SMOLAGENTS_GENERAL_MODEL_ID=qwen3.5:9b-64k

# ─── Reviewer pools (optional) ────────────────────────────────────────────────
# Comma-separated models the audit agent consults for second opinions on
# finished work: same expertise as the lead, lower benchmark scores, plus a
# different lineage (gpt-oss) to decorrelate blind spots.
#SMOLAGENTS_CODING_REVIEW_MODEL_IDS=qwen3-coder:30b,gpt-oss:20b
#SMOLAGENTS_GENERAL_REVIEW_MODEL_IDS=gemma4:12b,gpt-oss:20b

# ─── Agent behavior (optional) ────────────────────────────────────────────────
# Max reasoning/tool steps per agent run.
#SMOLAGENTS_MAX_STEPS=12

# Manager orchestration: step headroom, replanning cadence, and the segment
# cap for long background jobs (each segment resumes from the workspace
# synopsis — see agents/jobs.py).
#SMOLAGENTS_MANAGER_MAX_STEPS=20
#SMOLAGENTS_PLANNING_INTERVAL=5
#SMOLAGENTS_MAX_SEGMENTS=8

# ─── Debate system (optional) ─────────────────────────────────────────────────
# Three fixed personas (entrepreneur, critic, monitor) argue a goal in
# series, one turn per background job (see agents/debate_manager.py,
# agents/debate/). Entrepreneur/monitor default to the most capable model
# (qwen3.6:35b-64k, same as the default-chat lead) since both make judgment
# calls where quality matters more than the VRAM-swap cost, which is fine
# for an unattended background tool; critic defaults to a different lineage
# (gpt-oss:20b) so it doesn't share the others' blind spots.
#SMOLAGENTS_DEBATE_ENTREPRENEUR_MODEL_ID=qwen3.6:35b-64k
#SMOLAGENTS_DEBATE_CRITIC_MODEL_ID=gpt-oss:20b
#SMOLAGENTS_DEBATE_MONITOR_MODEL_ID=qwen3.6:35b-64k
#SMOLAGENTS_DEBATE_MANAGER_MAX_STEPS=8
#SMOLAGENTS_DEBATE_ROUND_MAX_CHARS=8000
#SMOLAGENTS_DEBATE_MANIFEST_RENDER_LIMIT=25
#SMOLAGENTS_DEBATE_RECENT_ROUNDS_FULL=2
#SMOLAGENTS_DEBATE_MONITOR_EVERY_N=2

# ─── Researcher (optional) ────────────────────────────────────────────────────
# Dedicated researcher agent (agents/researcher_agent.py): structured,
# multi-source research briefs, delegatable by the manager and the debate
# orchestrator. Empty = the resident general lead (no VRAM swap to consult
# it). Step budgets are role-shaped: research is exploration and gets a
# deep internal budget (its whole run counts as ONE step of its caller);
# debate personas stay bounded — a persona turn is one argument, and the
# debate itself is bounded by max_rounds + the monitor's verdict.
#SMOLAGENTS_RESEARCHER_MODEL_ID=
#SMOLAGENTS_RESEARCHER_MAX_STEPS=40
#SMOLAGENTS_DEBATE_PERSONA_MAX_STEPS=12

# ─── Alexa liaison (optional) ─────────────────────────────────────────────────
# Dedicated CodeAgent (agents/alexa_liaison.py) that owns one turn of a
# voice conversation coming from the alexa-bridge service, via mcp-tools'
# liaison_turn. Uses SMOLAGENTS_GENERAL_MODEL_ID like most of the team — no
# separate model id, unlike the debate system, since a turn is a single
# quick answer/delegate/dispatch decision, not a distinct persona.
#SMOLAGENTS_LIAISON_HISTORY_TURNS=12
#SMOLAGENTS_LIAISON_MAX_STEPS=6
#SMOLAGENTS_LIAISON_SESSION_STALE_HOURS=6

# ─── Background jobs (optional) ───────────────────────────────────────────────
# Webhook (e.g. n8n) POSTed when a background job completes, fails, or needs
# attention. Empty disables notifications.
#SMOLAGENTS_NOTIFY_WEBHOOK=

# Public mcp-tools URL used for inbox links in reports/notifications.
#SMOLAGENTS_MCP_PUBLIC_URL=http://mcp.localhost

# ─── MCP tool server (optional) ───────────────────────────────────────────────
# Shared tool server (mcp-tools) providing web search and service tools.
# Agents degrade gracefully (fewer tools) when it is not running.
#   From inside the container (default): http://host.docker.internal:8099
#   From a host venv (uv run):           http://localhost:8099
#SMOLAGENTS_MCP_URL=http://host.docker.internal:8099

# ─── Hugging Face (optional) ──────────────────────────────────────────────────
# Only needed to load gated tools/models from the Hub.
#HF_TOKEN=

# ─── Telemetry (optional) ─────────────────────────────────────────────────────
# OTLP HTTP endpoint for agent traces (e.g. a local Arize Phoenix instance).
# Leave unset to disable instrumentation.
#OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:6006/v1/traces

# ─── Timezone ─────────────────────────────────────────────────────────────────
TZ=America/Chicago

# ─── Data path (optional) ─────────────────────────────────────────────────────
# Host path for agent outputs and Gradio file uploads.
SMOLAGENTS_DATA_PATH=./data/smolagents
