# ─── SearXNG — Private Metasearch Engine ──────────────────────────────────────
# Aggregates results from public search engines (Google, Bing, DuckDuckGo, ...)
# without API keys. Used as the web-search backend for openwebui and
# mcp-tools.

# ─── SearXNG ──────────────────────────────────────────────────────────────────
# Port SearXNG listens on (host side).
SEARXNG_PORT_HOST=8098

# Public base URL of the instance (used in redirects and generated links).
SEARXNG_BASE_URL=http://localhost:8098/

# Secret key used to sign server-side data. Auto-generated by start.sh on first run.
SEARXNG_SECRET=GENERATE_ME

# ─── Data path (optional) ─────────────────────────────────────────────────────
# Host path for SearXNG's cache data.
# Override with an absolute path to store data on a separate drive or NAS.
SEARXNG_DATA_PATH=./data/searxng

# ─── Timezone ─────────────────────────────────────────────────────────────────
TZ=America/Chicago
