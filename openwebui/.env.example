# ─── Open WebUI — LLM Chat Interface ─────────────────────────────────────────
# Provides a ChatGPT-style UI over Ollama (or any OpenAI-compatible backend).
# Requires makerops-core/ai/ollama to be running before starting this service.

# ─── Open WebUI ───────────────────────────────────────────────────────────────
# Port Open WebUI listens on (host side).
OPENWEBUI_PORT_HOST=8080

# Ollama API endpoint. The default resolves to the host machine from inside the
# container, which is where Ollama runs.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Backend HTTP client timeout (seconds) for calls to Ollama/OpenAI-compatible
# backends. Open WebUI's own default is 300s (5 min) — too short once a
# preset runs a dense/slow model (e.g. qwen3.8:27b-64k): the generation can
# legitimately take 10-15+ minutes on this hardware, completes successfully
# server-side (confirmed via Ollama's own logs), but gets silently dropped
# client-side at the 5-minute mark — the chat message is left permanently
# "done: false", empty, with no error. Looks exactly like a missing/broken
# tool (observed 2026-08-29: Debate Moderator appeared to lack access to
# debate_start; the tool was fine, the response was just discarded).
# 1800s matches the smolagents side's SMOLAGENTS_MODEL_TIMEOUT_S convention.
AIOHTTP_CLIENT_TIMEOUT=1800

# Secret key used to sign session tokens. Auto-generated by start.sh on first run.
WEBUI_SECRET_KEY=GENERATE_ME

# ─── Web search (via searxng) ─────────────────────────────────────────────
# NOTE: these are "PersistentConfig" variables — Open WebUI copies them into
# its database on FIRST boot only. After that, change them in Admin Settings →
# Web Search instead (or set ENABLE_PERSISTENT_CONFIG=false to always use env).
ENABLE_WEB_SEARCH=true
WEB_SEARCH_ENGINE=searxng
SEARXNG_QUERY_URL=http://host.docker.internal:8098/search?q=<query>&format=json
WEB_SEARCH_RESULT_COUNT=5

# ─── Data path (optional) ─────────────────────────────────────────────────────
# Host path for Open WebUI's persistent data (user accounts, chat history, RAG).
# Override with an absolute path to store data on a separate drive or NAS.
OPENWEBUI_DATA_PATH=./data/openwebui
