# ─── Speech — Voice Services (STT + TTS) ──────────────────────────────────────
# speaches (faster-whisper) speech-to-text and Kokoro text-to-speech, both
# OpenAI-compatible and CPU-only. Wired into Open WebUI under
# Admin Settings → Audio (see README.md).

# ─── Network ──────────────────────────────────────────────────────────────────
# Host port for speech-to-text (speaches, /v1/audio/transcriptions).
SPEECH_STT_PORT_HOST=8091

# Host port for text-to-speech (Kokoro, /v1/audio/speech).
SPEECH_TTS_PORT_HOST=8093

# ─── Models ───────────────────────────────────────────────────────────────────
# Whisper model requested by clients (Open WebUI's STT model field). speaches
# downloads it from Hugging Face on first use; larger = more accurate, slower
# on CPU. Alternatives: Systran/faster-whisper-base, ...-medium, ...-large-v3.
# This value is client-side — set it in Open WebUI, kept here for reference.
#SPEECH_STT_MODEL=Systran/faster-whisper-small

# ─── Data path (optional) ─────────────────────────────────────────────────────
# Host path for the downloaded Whisper model cache.
SPEECH_DATA_PATH=./data/speech

# ─── Timezone ─────────────────────────────────────────────────────────────────
TZ=America/Chicago
