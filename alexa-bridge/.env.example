# ─── alexa-bridge — Amazon Alexa custom-skill backend ────────────────────────
# See docs/alexa-voice-setup.md for the full setup walkthrough (Cloudflare
# Tunnel + Alexa Developer Console steps this service depends on).

# ─── Network ──────────────────────────────────────────────────────────────────
ALEXA_BRIDGE_PORT_HOST=8103

# ─── Alexa skill ──────────────────────────────────────────────────────────────
# Skill ID from the Alexa Developer Console (shown at the top of the skill's
# build page once created) — the main defense against a leaked endpoint
# being replayed against it from an unrelated skill. Leave empty only
# before the skill exists yet; never leave it empty once the tunnel is
# live.
ALEXA_SKILL_APPLICATION_ID=

# ─── mcp-tools ────────────────────────────────────────────────────────────────
MCP_TOOLS_URL=http://host.docker.internal:8099
# Same token as mcp-tools/.env's APPROVALS_TOKEN — used for the deterministic
# confirm/deny voice commands, which call mcp-tools' /approvals/{id}/{verb}
# route directly (see alexa/mcp_client.py's resolve_approval).
APPROVALS_TOKEN=

# ─── Dev/test ─────────────────────────────────────────────────────────────────
# Bypasses signature/timestamp verification for local curl testing only.
# Must be false whenever the Cloudflare Tunnel is live — it turns off the
# only thing standing between the public internet and this endpoint.
DEV_MODE=false

# How long one Alexa turn waits for the liaison's reply before giving up and
# replying "still working" — kept under Alexa's ~8s hard response timeout.
TURN_POLL_TIMEOUT_S=6.0
TURN_POLL_INTERVAL_S=0.5

# ─── Timezone ─────────────────────────────────────────────────────────────────
TZ=America/Chicago
