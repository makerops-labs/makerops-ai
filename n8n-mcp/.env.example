# ─── n8n-mcp — MCP server for agentic n8n workflow management ─────────────────
# Wraps the existing makerops-core n8n public REST API with node-documentation,
# template, validation, and workflow-management tools. HTTP (Streamable) MCP
# mode. See README.md.

# ─── Server ─────────────────────────────────────────────────────────────────
# Host port for the MCP endpoint (container listens on 3000).
N8NMCP_PORT_HOST=8104

# Bearer token every MCP client must send (Authorization: Bearer <token>).
# Auto-generated by start.sh on first run (openssl rand -base64 32).
# Open WebUI's External Tool connection uses this as its API key (NOT `no-key`).
N8NMCP_AUTH_TOKEN=GENERATE_ME

# ─── Target n8n ─────────────────────────────────────────────────────────────
# The existing makerops-core n8n, reached over the Docker host gateway.
N8N_API_URL=http://host.docker.internal:5678
# n8n → Settings → n8n API → Create an API key. The SAME key already sits in
# ../mcp-tools/.env as N8N_API_KEY (JWT, aud=public-api) — reuse that value.
# A key rotation must update both files.
N8N_API_KEY=

# ─── Security ──────────────────────────────────────────────────────────────
# strict blocks localhost + private IPs; moderate allows loopback only;
# permissive allows private IPs. host.docker.internal is a private gateway IP
# and n8n-mcp validates N8N_API_URL through this same gate, so permissive is
# required here. Single-user homelab LAN — acceptable.
N8NMCP_WEBHOOK_SECURITY_MODE=permissive
N8NMCP_LOG_LEVEL=info

# ─── Write-safety (no approval-gate proxy on this path) ─────────────────────
# Destructive / secret-bearing tools removed entirely, plus workflow-execution
# and n8n-Agents tools (this builder designs workflows; it does not run them or
# manage AI agents). Verified against n8n-mcp 2.76.0 — leaves 18 tools:
#   read/discover : tools_documentation, search_nodes, get_node, search_templates,
#                   get_template, n8n_list_workflows, n8n_get_workflow,
#                   n8n_list_catalog, n8n_executions (get/list only — delete
#                   blocked below), n8n_health_check
#   validate      : validate_node, validate_workflow, n8n_validate_workflow,
#                   n8n_autofix_workflow
#   build/deploy  : n8n_create_workflow, n8n_update_partial_workflow (diff),
#                   n8n_update_full_workflow, n8n_deploy_template
#
# Tool names vary by version. The MCP endpoint needs an initialize handshake, so
# a bare `curl .../mcp -d '{...tools/list}'` 400s — use an MCP client to list
# them (see README.md "Verify").
N8NMCP_DISABLED_TOOLS=n8n_delete_workflow,n8n_manage_credentials,n8n_manage_datatable,n8n_manage_folders,n8n_workflow_versions,n8n_manage_agents,n8n_test_workflow,n8n_evaluations,n8n_audit_instance,n8n_explore_node_resources
N8NMCP_DISABLED_TOOL_OPERATIONS=n8n_executions:delete

# ─── Timezone ──────────────────────────────────────────────────────────────
TZ=America/Chicago
